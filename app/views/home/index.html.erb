<!-- Hero Section -->
<section class="relative min-h-[85vh] flex items-center overflow-hidden" style="background: linear-gradient(135deg, #fff8f5 0%, #fbf2ed 100%);">
  <div class="max-w-[1440px] mx-auto px-8 grid grid-cols-1 md:grid-cols-12 gap-8 items-center w-full">
    <div class="md:col-span-6 space-y-4">
      <span class="text-customer-primary text-xs uppercase tracking-widest block font-semibold">Premium Nail Art Experience</span>
      <h1 class="text-5xl md:text-6xl font-['Bodoni_Moda'] text-customer-text leading-tight">
        Elevate Your <br>
        <span class="italic text-customer-primary">Natural Beauty</span>
      </h1>
      <p class="text-lg text-customer-text-muted max-w-lg">
        Indulge in a sanctuary of serenity. Our expert technicians combine artistic precision with luxurious care to create masterpieces on your fingertips.
      </p>
      <div class="pt-4 flex gap-4">
        <%= link_to "Our Collections", services_path, class: "bg-customer-primary text-white px-8 py-4 rounded-full font-medium hover:shadow-lg transition-all" %>
        <%= link_to "View Services", services_path, class: "border border-customer-tertiary text-customer-primary px-8 py-4 rounded-full font-medium hover:bg-customer-surface-container transition-all" %>
      </div>
    </div>
    <div class="md:col-span-6 relative h-[500px] w-full">
      <div class="absolute inset-0 rounded-[40px] overflow-hidden shadow-2xl">
        <%= image_tag "hero-nail.jpg", class: "w-full h-full object-cover", alt: "Nail art premium DIFNails" %>
      </div>
      <div class="absolute -bottom-8 -left-8 bg-white/60 backdrop-blur-xl border border-customer-outline-variant p-6 rounded-2xl shadow-xl max-w-xs">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-customer-primary-container rounded-full flex items-center justify-center text-customer-primary">✨</div>
          <div>
            <p class="font-semibold text-customer-text">500+ Designs</p>
            <p class="text-xs text-customer-text-muted">Handcrafted with love</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Services Highlight -->
<section class="py-20 bg-customer-surface">
  <div class="max-w-[1440px] mx-auto px-8">
    <div class="text-center mb-16 space-y-4">
      <h2 class="text-4xl font-['Bodoni_Moda'] text-customer-text">Our Exquisite Services</h2>
      <p class="text-customer-text-muted max-w-2xl mx-auto">Discover our range of premium nail treatments designed for the modern individual seeking perfection.</p>
    </div>

    <% if @featured_services&.any? %>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <% @featured_services.each do |service| %>
          <div class="group relative overflow-hidden rounded-[32px] h-[350px]">
            <% if service.photo.attached? %>
              <%= image_tag service.photo, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" %>
            <% elsif service.image_url.present? %>
              <%= image_tag service.image_url, class: "w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" %>
            <% else %>
              <div class="w-full h-full bg-customer-surface-container"></div>
            <% end %>
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent flex flex-col justify-end p-6">
              <h3 class="text-xl font-['Bodoni_Moda'] text-white"><%= service.name %></h3>
              <p class="text-sm text-white/80"><%= service.description %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="text-center mt-12">
      <%= link_to "Lihat Semua Layanan →", services_path, class: "text-customer-primary font-medium" %>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="py-24 px-8">
  <div class="max-w-[1440px] mx-auto bg-white/60 backdrop-blur-xl border border-customer-outline-variant rounded-[48px] p-12 md:p-20 text-center">
    <h2 class="text-4xl font-['Bodoni_Moda'] mb-6 text-customer-text">Ready for a Transformation?</h2>
    <p class="text-customer-text-muted max-w-xl mx-auto mb-10">Book your appointment today and step into a world of elegance and artistry.</p>
    <%= link_to new_booking_path, class: "inline-flex items-center gap-2 bg-customer-primary text-white px-10 py-5 rounded-full font-medium hover:scale-105 transition-transform" do %>
      Reserve Your Slot
    <% end %>
  </div>
</section>