<div class="space-y-8">
  <!-- Page Title -->
  <div>
    <h1 class="text-3xl font-semibold tracking-tight text-white">Dashboard Overview</h1>
    <p class="text-sm text-admin-text-muted mt-1">Real-time salon performance and operational queue.</p>
  </div>

  <!-- Stats Grid -->
  <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
    <!-- Revenue -->
    <div class="bg-admin-surface border border-admin-outline-variant/30 rounded-xl p-6 flex flex-col justify-between h-32">
      <span class="text-xs font-semibold tracking-wider text-admin-tertiary uppercase">Total Revenue</span>
      <span class="text-3xl font-bold text-white tracking-tight mt-2">
        <%= number_to_currency(@total_revenue, unit: "Rp ", precision: 0, delimiter: ".") %>
      </span>
    </div>

    <!-- Active Queue -->
    <div class="bg-admin-surface border border-admin-outline-variant/30 rounded-xl p-6 flex flex-col justify-between h-32">
      <span class="text-xs font-semibold tracking-wider text-admin-tertiary uppercase">Today's Queue</span>
      <span class="text-3xl font-bold text-white tracking-tight mt-2"><%= @active_queue_count %></span>
    </div>

    <!-- Services Count -->
    <div class="bg-admin-surface border border-admin-outline-variant/30 rounded-xl p-6 flex flex-col justify-between h-32">
      <span class="text-xs font-semibold tracking-wider text-admin-tertiary uppercase">Active Services</span>
      <span class="text-3xl font-bold text-white tracking-tight mt-2"><%= @total_services_count %></span>
    </div>

    <!-- Customers Count -->
    <div class="bg-admin-surface border border-admin-outline-variant/30 rounded-xl p-6 flex flex-col justify-between h-32">
      <span class="text-xs font-semibold tracking-wider text-admin-tertiary uppercase">Active Clients</span>
      <span class="text-3xl font-bold text-white tracking-tight mt-2"><%= @active_customers_count %></span>
    </div>
  </div>

  <!-- Dashboard Tables Layout -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Today's Appointments (Left 2 Columns) -->
    <div class="lg:col-span-2 bg-admin-surface border border-admin-outline-variant/30 rounded-xl p-6 space-y-6">
      <div class="flex justify-between items-center">
        <h2 class="text-lg font-semibold text-white">Today's Appointments</h2>
        <span class="text-xs text-admin-primary bg-admin-primary-container/20 px-3 py-1 rounded-full font-medium">
          <%= Date.today.strftime("%B %d, %Y") %>
        </span>
      </div>

      <% if @today_appointments.any? %>
        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm">
            <thead>
              <tr class="border-b border-admin-outline-variant/50 text-admin-tertiary">
                <th class="py-3 font-semibold text-xs tracking-wider uppercase">Time</th>
                <th class="py-3 font-semibold text-xs tracking-wider uppercase">Customer</th>
                <th class="py-3 font-semibold text-xs tracking-wider uppercase">Service</th>
                <th class="py-3 font-semibold text-xs tracking-wider uppercase">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-admin-outline-variant/30">
              <% @today_appointments.each do |booking| %>
                <tr class="hover:bg-admin-low/40 transition-colors">
                  <td class="py-4 font-medium text-admin-primary"><%= booking.booking_time.strftime("%H:%M") %></td>
                  <td class="py-4 font-semibold text-white">
                    <%= booking.customer.name %>
                    <span class="block text-xs text-admin-text-muted font-normal"><%= booking.customer.phone %></span>
                  </td>
                  <td class="py-4 text-admin-text">
                    <%= booking.service.name %>
                    <span class="block text-xs text-admin-tertiary font-normal"><%= number_to_currency(booking.service.price, unit: "Rp ", precision: 0, delimiter: ".") %></span>
                  </td>
                  <td class="py-4">
                    <% status_classes = case booking.status
                       when 'pending' then 'bg-amber-950/40 text-amber-400 border border-amber-800/35'
                       when 'confirmed' then 'bg-blue-950/40 text-blue-400 border border-blue-800/35'
                       when 'completed' then 'bg-emerald-950/40 text-emerald-400 border border-emerald-800/35'
                       else 'bg-admin-surface-highest text-admin-text-muted border border-admin-outline'
                       end %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold tracking-wider <%= status_classes %>">
                      <%= booking.status.upcase %>
                    </span>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="text-sm text-admin-text-muted py-6">No appointments scheduled for today.</p>
      <% end %>
    </div>

    <!-- Recent Activity / Bookings (Right 1 Column) -->
    <div class="bg-admin-surface border border-admin-outline-variant/30 rounded-xl p-6 space-y-6">
      <h2 class="text-lg font-semibold text-white">Recent Bookings</h2>
      <div class="space-y-4">
        <% if @recent_bookings.any? %>
          <% @recent_bookings.each do |booking| %>
            <div class="flex justify-between items-start pb-4 border-b border-admin-outline-variant/30 last:border-0 last:pb-0">
              <div class="space-y-1">
                <span class="text-sm font-semibold text-white"><%= booking.customer.name %></span>
                <p class="text-xs text-admin-text-muted">Booked <%= booking.service.name %></p>
                <div class="text-[10px] text-admin-tertiary font-medium">
                  <%= booking.booking_date.strftime("%b %d") %> @ <%= booking.booking_time.strftime("%H:%M") %>
                </div>
              </div>
              <span class="text-xs text-admin-primary"><%= time_ago_in_words(booking.created_at) %> ago</span>
            </div>
          <% end %>
        <% else %>
          <p class="text-sm text-admin-text-muted py-4">No recent bookings recorded.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>
