<div class="max-w-6xl mx-auto space-y-8">
  <!-- Header & Search -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div>
      <h2 class="text-2xl font-['Libre_Caslon_Text'] text-admin-primary">Manajemen Reservasi</h2>
      <p class="text-admin-text-muted mt-1">Kelola jadwal booking pelanggan hari ini dan mendatang.</p>
    </div>

    <%= form_with url: admin_bookings_path, method: :get, local: true do %>
      <% if params[:status].present? %>
        <%= hidden_field_tag :status, params[:status] %>
      <% end %>
      <input type="text" name="q" value="<%= params[:q] %>" placeholder="Cari nama atau nomor HP..." class="w-72 bg-white border border-admin-outline-variant/30 rounded-full py-2.5 px-5 text-sm focus:ring-2 focus:ring-admin-primary/20">
    <% end %>
  </div>

  <!-- Filter Pills -->
  <div class="flex flex-wrap gap-2">
    <%= link_to "Semua", admin_bookings_path(q: params[:q]), class: "px-4 py-2 rounded-full text-sm font-bold #{params[:status].blank? ? 'bg-admin-primary text-white shadow-md' : 'bg-white text-admin-text-muted hover:bg-admin-surface-container'}" %>
    <% { "pending" => "Menunggu", "confirmed" => "Dikonfirmasi", "completed" => "Selesai", "cancelled" => "Dibatalkan" }.each do |value, label| %>
      <%= link_to label, admin_bookings_path(status: value, q: params[:q]), class: "px-4 py-2 rounded-full text-sm font-bold #{params[:status] == value ? 'bg-admin-primary text-white shadow-md' : 'bg-white text-admin-text-muted hover:bg-admin-surface-container'}" %>
    <% end %>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-2xl shadow-sm overflow-hidden border border-admin-outline-variant/20">
    <% if @bookings.empty? %>
      <p class="p-12 text-center text-admin-text-muted">Tidak ada reservasi ditemukan.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="bg-admin-surface-container-low/50">
              <th class="px-6 py-4 text-xs font-bold text-admin-text-muted uppercase tracking-wider">Nama Pelanggan</th>
              <th class="px-6 py-4 text-xs font-bold text-admin-text-muted uppercase tracking-wider">Layanan</th>
              <th class="px-6 py-4 text-xs font-bold text-admin-text-muted uppercase tracking-wider">Tanggal & Jam</th>
              <th class="px-6 py-4 text-xs font-bold text-admin-text-muted uppercase tracking-wider">Status</th>
              <th class="px-6 py-4 text-xs font-bold text-admin-text-muted uppercase tracking-wider text-right">Aksi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-admin-outline-variant/10">
            <% @bookings.each do |booking| %>
              <tr class="hover:bg-admin-primary-fixed/5 transition-colors">
                <td class="px-6 py-5">
                  <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-full bg-admin-secondary-fixed flex items-center justify-center text-admin-secondary font-bold text-sm">
                      <%= customer_initials(booking.customer.name) %>
                    </div>
                    <div>
                      <p class="font-bold text-admin-text"><%= booking.customer.name %></p>
                      <p class="text-xs text-admin-outline"><%= booking.customer.phone %></p>
                    </div>
                  </div>
                </td>
                <td class="px-6 py-5">
                  <p class="text-sm font-medium text-admin-text"><%= booking.service.name %></p>
                  <% if booking.service.duration_minutes.present? %>
                    <p class="text-[10px] text-admin-outline uppercase"><%= booking.service.duration_minutes %> Menit</p>
                  <% end %>
                </td>
                <td class="px-6 py-5">
                  <p class="text-sm font-bold text-admin-text"><%= booking.booking_date.strftime("%d %b %Y") %></p>
                  <p class="text-sm text-admin-outline"><%= booking.booking_time.strftime("%H:%M") %> WIB</p>
                </td>
                <td class="px-6 py-5">
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold <%= status_badge_class(booking.status) %>">
                    <%= status_label(booking.status) %>
                  </span>
                </td>
                <td class="px-6 py-5 text-right">
                  <%= link_to admin_booking_path(booking), class: "inline-block p-2 rounded-full hover:bg-admin-primary-fixed/20 text-admin-primary transition-colors" do %>
                    Lihat
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>