<div class="max-w-3xl mx-auto space-y-8">
  <%= link_to "&larr; Kembali ke Daftar Pelanggan".html_safe, admin_customers_path, class: "text-sm text-admin-primary hover:underline" %>

  <!-- Header -->
  <div class="bg-white rounded-2xl shadow-sm border border-admin-outline-variant/20 p-8 flex items-center gap-6">
    <div class="w-16 h-16 rounded-2xl bg-admin-primary-fixed text-admin-primary flex items-center justify-center font-bold text-2xl">
      <%= customer_initials(@customer.name) %>
    </div>
    <div>
      <h3 class="text-xl font-['Libre_Caslon_Text'] text-admin-primary"><%= @customer.name %></h3>
      <p class="text-sm text-admin-outline"><%= @customer.phone %> · Terdaftar sejak <%= @customer.created_at.strftime("%b %Y") %></p>
    </div>
  </div>

  <!-- Quick Stats -->
  <div class="grid grid-cols-3 gap-4">
    <div class="bg-white p-5 rounded-2xl shadow-sm border border-admin-outline-variant/20 text-center">
      <p class="text-xs text-admin-outline uppercase tracking-wider mb-1">Total Kunjungan</p>
      <p class="text-2xl font-bold text-admin-primary"><%= @bookings.count %></p>
    </div>
    <div class="bg-white p-5 rounded-2xl shadow-sm border border-admin-outline-variant/20 text-center">
      <p class="text-xs text-admin-outline uppercase tracking-wider mb-1">Total Pengeluaran</p>
      <p class="text-xl font-bold text-admin-text"><%= number_to_currency(@total_spent, unit: "Rp ", precision: 0, delimiter: ".") %></p>
    </div>
    <div class="bg-white p-5 rounded-2xl shadow-sm border border-admin-outline-variant/20 text-center">
      <p class="text-xs text-admin-outline uppercase tracking-wider mb-1">Layanan Favorit</p>
      <p class="text-sm font-bold text-admin-text mt-2"><%= favorite_service_for(@customer) %></p>
    </div>
  </div>

  <!-- Booking History -->
  <div class="bg-white rounded-2xl shadow-sm border border-admin-outline-variant/20 p-8">
    <h4 class="text-xs font-bold text-admin-primary uppercase tracking-[0.2em] mb-6">Riwayat Reservasi</h4>

    <% if @bookings.empty? %>
      <p class="text-sm text-admin-text-muted">Belum ada riwayat booking.</p>
    <% else %>
      <div class="space-y-6">
        <% @bookings.each do |booking| %>
          <div class="relative pl-8 border-l border-admin-outline-variant/30 pb-2">
            <div class="absolute left-[-4px] top-1 w-2 h-2 rounded-full <%= booking.status == 'completed' ? 'bg-admin-primary' : 'bg-admin-outline-variant' %>"></div>
            <div class="flex justify-between items-start">
              <div>
                <p class="font-bold text-admin-text"><%= booking.service.name %></p>
                <p class="text-xs text-admin-outline">ID: BK-<%= booking.id.to_s.rjust(4, '0') %></p>
              </div>
              <p class="font-bold text-admin-primary"><%= number_to_currency(booking.service.price, unit: "Rp ", precision: 0, delimiter: ".") %></p>
            </div>
            <div class="mt-2 flex items-center gap-3">
              <span class="text-xs text-admin-outline"><%= booking.booking_date.strftime("%d %b %Y") %>, <%= booking.booking_time.strftime("%H:%M") %></span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= status_badge_class(booking.status) %>">
                <%= status_label(booking.status) %>
              </span>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>