<div class="max-w-6xl mx-auto space-y-8">
  <div class="flex flex-col md:flex-row justify-between items-end gap-6">
    <div>
      <h2 class="text-2xl font-['Libre_Caslon_Text'] text-admin-primary">Manajemen Pelanggan</h2>
      <p class="text-admin-text-muted mt-1">Kelola data dan riwayat pelanggan DIFNails.</p>
    </div>
    <%= form_with url: admin_customers_path, method: :get, local: true do %>
      <input type="text" name="q" value="<%= params[:q] %>" placeholder="Cari nama atau nomor HP..." class="w-72 bg-white border border-admin-outline-variant/30 rounded-full py-2.5 px-5 text-sm focus:ring-2 focus:ring-admin-primary/20">
    <% end %>
  </div>

  <div class="bg-white rounded-2xl shadow-sm border border-admin-outline-variant/20 overflow-hidden">
    <% if @customers.empty? %>
      <p class="p-12 text-center text-admin-text-muted">Belum ada pelanggan terdaftar.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-left">
          <thead>
            <tr class="bg-admin-surface-container-low/50 border-b border-admin-outline-variant/20">
              <th class="px-8 py-5 text-xs font-bold text-admin-outline uppercase tracking-wider">Nama</th>
              <th class="px-6 py-5 text-xs font-bold text-admin-outline uppercase tracking-wider">Kontak</th>
              <th class="px-6 py-5 text-xs font-bold text-admin-outline uppercase tracking-wider">Total Booking</th>
              <th class="px-6 py-5 text-xs font-bold text-admin-outline uppercase tracking-wider">Layanan Favorit</th>
              <th class="px-6 py-5 text-xs font-bold text-admin-outline uppercase tracking-wider">Total Pengeluaran</th>
              <th class="px-6 py-5 text-xs font-bold text-admin-outline uppercase tracking-wider text-right">Booking Terakhir</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-admin-outline-variant/10">
            <% @customers.each do |customer| %>
              <% last_booking = customer.bookings.order(booking_date: :desc, booking_time: :desc).first %>
              <tr class="hover:-translate-y-0.5 hover:shadow-md transition-all cursor-pointer" onclick="window.location='<%= admin_customer_path(customer) %>'">
                <td class="px-8 py-6">
                  <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-full bg-admin-primary-fixed text-admin-primary flex items-center justify-center font-bold">
                      <%= customer_initials(customer.name) %>
                    </div>
                    <span class="font-bold text-admin-primary"><%= customer.name %></span>
                  </div>
                </td>
                <td class="px-6 py-6 text-sm text-admin-outline"><%= customer.phone %></td>
                <td class="px-6 py-6">
                  <span class="bg-admin-primary-fixed/30 text-admin-primary px-3 py-1 rounded-full text-sm font-bold"><%= customer.bookings.count %> Kali</span>
                </td>
                <td class="px-6 py-6">
                  <span class="text-sm text-admin-text-muted border border-admin-outline-variant rounded-md px-2 py-0.5"><%= favorite_service_for(customer) %></span>
                </td>
                <td class="px-6 py-6 font-bold text-admin-text"><%= number_to_currency(customer_total_spent(customer), unit: "Rp ", precision: 0, delimiter: ".") %></td>
                <td class="px-6 py-6 text-right">
                  <% if last_booking %>
                    <p class="text-sm text-admin-text"><%= last_booking.booking_date.strftime("%d %b %Y") %></p>
                    <p class="text-xs text-admin-outline"><%= last_booking.booking_time.strftime("%H:%M") %> WIB</p>
                  <% else %>
                    <p class="text-sm text-admin-outline">-</p>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>