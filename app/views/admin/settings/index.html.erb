<div class="max-w-4xl mx-auto space-y-8 pb-12">
  <h2 class="text-2xl font-['Libre_Caslon_Text'] text-admin-primary">Settings</h2>

  <!-- Admin Profile -->
  <section class="bg-white rounded-2xl p-8 shadow-sm border border-admin-outline-variant/20">
    <h3 class="text-lg font-['Libre_Caslon_Text'] text-admin-primary mb-1">Profil Admin</h3>
    <p class="text-sm text-admin-outline mb-6">Kelola informasi akun Anda.</p>

    <%= form_with model: @admin_user, url: admin_update_profile_settings_path, method: :patch, local: true, class: "space-y-6" do |f| %>      <% if @admin_user.errors.any? %>
        <div class="p-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">
          <ul class="list-disc pl-5">
            <% @admin_user.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-2">
          <%= f.label :name, "Nama Lengkap", class: "text-sm font-bold text-admin-text" %>
          <%= f.text_field :name, class: "w-full bg-admin-surface-container-low border-0 rounded-xl px-4 py-3 focus:ring-2 focus:ring-admin-primary" %>
        </div>
        <div class="space-y-2">
          <%= f.label :email, "Email", class: "text-sm font-bold text-admin-text" %>
          <%= f.email_field :email, class: "w-full bg-admin-surface-container-low border-0 rounded-xl px-4 py-3 focus:ring-2 focus:ring-admin-primary" %>
        </div>
      </div>

      <%= f.submit "Simpan Profil", class: "px-6 py-3 bg-admin-primary text-white font-bold rounded-xl hover:opacity-90 transition-all cursor-pointer" %>
    <% end %>

    <div class="mt-6 pt-6 border-t border-admin-outline-variant/20">
      <%= link_to edit_admin_user_registration_path, class: "inline-flex items-center gap-2 px-6 py-3 border-2 border-admin-primary text-admin-primary font-bold rounded-xl hover:bg-admin-primary-fixed/20 transition-all" do %>
        🔒 Ganti Password
      <% end %>
    </div>
  </section>

  <!-- Operating Hours -->
  <section class="bg-white rounded-2xl p-8 shadow-sm border border-admin-outline-variant/20">
    <h3 class="text-lg font-['Libre_Caslon_Text'] text-admin-primary mb-1">Jam Operasional</h3>
    <p class="text-sm text-admin-outline mb-6">Atur jam buka dan tutup salon per hari.</p>

    <%= form_with url: admin_update_hours_settings_path, method: :patch, local: true, class: "space-y-4" do %>      <% @operating_hours.each do |hour| %>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 bg-admin-surface-container-low rounded-2xl">
          <div class="flex items-center gap-4 sm:w-1/4">
            <label class="relative inline-flex items-center cursor-pointer">
              <input type="hidden" name="operating_hours[<%= hour.id %>][is_open]" value="0">
              <input type="checkbox" name="operating_hours[<%= hour.id %>][is_open]" value="1" <%= "checked" if hour.is_open %> class="sr-only peer">
              <div class="w-11 h-6 bg-admin-outline-variant rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-admin-primary relative"></div>
            </label>
            <span class="font-bold text-admin-text w-20"><%= hour.day_name %></span>
          </div>
          <div class="flex items-center gap-3">
            <input type="time" name="operating_hours[<%= hour.id %>][open_time]" value="<%= hour.open_time&.strftime('%H:%M') %>" class="bg-white border border-admin-outline-variant/30 rounded-lg px-3 py-2 text-sm">
            <span class="text-admin-outline">—</span>
            <input type="time" name="operating_hours[<%= hour.id %>][close_time]" value="<%= hour.close_time&.strftime('%H:%M') %>" class="bg-white border border-admin-outline-variant/30 rounded-lg px-3 py-2 text-sm">
            <span class="px-3 py-1 rounded-full text-[10px] font-bold uppercase <%= hour.is_open ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-600' %>">
              <%= hour.is_open ? "Buka" : "Tutup" %>
            </span>
          </div>
        </div>
      <% end %>

      <%= submit_tag "Simpan Jam Operasional", class: "px-6 py-3 bg-admin-primary text-white font-bold rounded-xl hover:opacity-90 transition-all cursor-pointer mt-4" %>
    <% end %>
  </section>
</div>