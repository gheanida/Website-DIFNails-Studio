<div class="flex justify-between items-end mb-8">
  <div>
    <h2 class="text-2xl font-['Libre_Caslon_Text'] text-admin-primary mb-1">Manajemen Katalog</h2>
    <p class="text-sm text-admin-outline">Kelola koleksi desain kuku dan layanan salon Anda.</p>
  </div>
  <%= link_to new_admin_service_path, class: "flex items-center gap-2 px-6 py-2.5 rounded-xl bg-admin-primary text-white font-bold hover:opacity-90 transition-all" do %>
    + Tambah Katalog Baru
  <% end %>
</div>

<% if @services.empty? %>
  <div class="bg-white rounded-2xl p-12 text-center border border-admin-outline-variant/20">
    <p class="text-admin-text-muted">Belum ada layanan di katalog.</p>
  </div>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
    <% @services.each do |service| %>
      <div class="bg-white rounded-2xl overflow-hidden border border-admin-outline-variant/10 shadow-sm hover:-translate-y-1 transition-transform">
        <div class="relative h-48 bg-admin-surface-container overflow-hidden">
          <% if service.photo.attached? %>
            <%= image_tag service.photo, class: "w-full h-full object-cover" %>
          <% elsif service.image_url.present? %>
            <%= image_tag service.image_url, class: "w-full h-full object-cover" %>
          <% end %>
          <div class="absolute top-3 left-3 bg-white/90 px-3 py-1 rounded-full flex items-center gap-1.5 shadow-sm">
            <span class="w-2 h-2 rounded-full <%= service.is_active? ? 'bg-green-500' : 'bg-gray-400' %>"></span>
            <span class="text-[10px] font-bold uppercase"><%= service.is_active? ? "Aktif" : "Nonaktif" %></span>
          </div>
        </div>
        <div class="p-5">
          <span class="text-[10px] font-bold text-admin-outline uppercase tracking-widest"><%= service.service_category&.name %></span>
          <h3 class="text-lg font-['Libre_Caslon_Text'] text-admin-primary mt-1 mb-3"><%= service.name %></h3>
          <div class="flex justify-between items-center">
            <p class="font-bold text-admin-text"><%= number_to_currency(service.price, unit: "Rp ", precision: 0, delimiter: ".") %></p>
            <div class="flex gap-3">
              <%= link_to "Edit", edit_admin_service_path(service), class: "text-admin-primary hover:underline text-sm font-semibold" %>
              <%= button_to "Hapus", admin_service_path(service), method: :delete, class: "text-red-600 hover:underline text-sm font-semibold bg-transparent border-0 p-0 cursor-pointer", data: { confirm: "Yakin hapus katalog ini?" } %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>