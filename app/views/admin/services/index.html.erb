<div class="space-y-8">
  <!-- Header -->
  <div class="flex justify-between items-center">
    <div>
      <h1 class="text-3xl font-semibold tracking-tight text-white">Services Directory</h1>
      <p class="text-sm text-admin-text-muted mt-1">Manage salon nail art offerings, manicures, pedicures, and extensions.</p>
    </div>
    <%= link_to "Add Service", new_admin_service_path, class: "px-5 py-2.5 rounded-lg bg-admin-primary-container text-white text-sm font-semibold tracking-wider hover:opacity-90 transition-all cursor-pointer border border-admin-outline-variant/30" %>
  </div>

  <!-- Services Grid/Table -->
  <div class="bg-admin-surface border border-admin-outline-variant/30 rounded-xl overflow-hidden">
    <% if @services.any? %>
      <div class="overflow-x-auto">
        <table class="w-full text-left text-sm whitespace-nowrap">
          <thead>
            <tr class="bg-admin-low border-b border-admin-outline-variant/50 text-admin-tertiary">
              <th class="px-6 py-3 font-semibold text-xs tracking-wider uppercase">Image</th>
              <th class="px-6 py-3 font-semibold text-xs tracking-wider uppercase">Name</th>
              <th class="px-6 py-3 font-semibold text-xs tracking-wider uppercase">Category</th>
              <th class="px-6 py-3 font-semibold text-xs tracking-wider uppercase">Price</th>
              <th class="px-6 py-3 font-semibold text-xs tracking-wider uppercase">Status</th>
              <th class="px-6 py-3 font-semibold text-xs tracking-wider uppercase text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-admin-outline-variant/30">
            <% @services.each do |service| %>
              <tr class="hover:bg-admin-low/40 transition-colors">
                <!-- Image -->
                <td class="px-6 py-4">
                  <% if service.image_url.present? %>
                    <img src="<%= service.image_url %>" alt="<%= service.name %>" class="w-12 h-12 object-cover rounded-lg border border-admin-outline-variant/50">
                  <% else %>
                    <div class="w-12 h-12 rounded-lg bg-admin-low flex items-center justify-center text-[10px] text-admin-text-muted border border-admin-outline-variant/50">No img</div>
                  <% end %>
                </td>

                <!-- Name & Description -->
                <td class="px-6 py-4">
                  <div class="font-semibold text-white"><%= service.name %></div>
                  <div class="text-xs text-admin-text-muted mt-0.5 max-w-xs truncate" title="<%= service.description %>">
                    <%= service.description %>
                  </div>
                </td>

                <!-- Category -->
                <td class="px-6 py-4 text-admin-text">
                  <%= service.service_category.name %>
                </td>

                <!-- Price -->
                <td class="px-6 py-4 font-semibold text-white">
                  <%= number_to_currency(service.price, unit: "Rp ", precision: 0, delimiter: ".") %>
                </td>

                <!-- Status -->
                <td class="px-6 py-4">
                  <% if service.is_active %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold tracking-wider bg-emerald-950/40 text-emerald-400 border border-emerald-800/35">
                      ACTIVE
                    </span>
                  <% else %>
                    <span class="px-2.5 py-1 rounded-full text-xs font-semibold tracking-wider bg-admin-surface-highest text-admin-text-muted border border-admin-outline">
                      INACTIVE
                    </span>
                  <% end %>
                </td>

                <!-- Actions -->
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-3">
                    <%= link_to "Edit", edit_admin_service_path(service), class: "text-xs font-medium text-admin-primary hover:text-white transition-colors" %>
                    <%= button_to admin_service_path(service), method: :delete, data: { confirm: "Are you sure you want to delete this service?" }, class: "text-xs font-medium text-red-400 hover:text-red-300 transition-colors bg-transparent border-0 cursor-pointer" do %>
                      Delete
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-12 text-center text-admin-text-muted">
        No services available. Create one to get started.
      </div>
    <% end %>
  </div>
</div>
