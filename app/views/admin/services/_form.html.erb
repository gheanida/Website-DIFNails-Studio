<%= form_with model: [:admin, @service], local: true, html: { multipart: true, class: "space-y-6" } do |f| %>
  <% if @service.errors.any? %>
    <div class="p-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">
      <ul class="list-disc pl-5">
        <% @service.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Upload Foto -->
    <div class="lg:col-span-4">
      <div class="bg-white rounded-2xl p-6 shadow-sm border border-admin-outline-variant/20">
        <h3 class="text-lg font-['Libre_Caslon_Text'] mb-4 text-admin-text">Foto Produk</h3>

        <% if @service.photo.attached? %>
          <div class="mb-4 rounded-xl overflow-hidden aspect-square bg-admin-surface-container">
            <%= image_tag @service.photo, class: "w-full h-full object-cover" %>
          </div>
        <% end %>

        <div class="border-2 border-dashed border-admin-outline-variant rounded-2xl p-6 text-center hover:border-admin-primary transition-colors">
          <%= f.file_field :photo, accept: "image/*", class: "w-full text-sm" %>
          <p class="text-xs text-admin-outline mt-2">Format: JPG, PNG (Maks. 5MB)</p>
        </div>

        <div class="mt-6 space-y-1.5">
          <label class="text-sm font-bold text-admin-text">Status</label>
          <div class="flex gap-4">
            <label class="flex items-center gap-2 cursor-pointer">
              <%= f.radio_button :is_active, true, checked: @service.is_active != false %>
              <span class="text-sm">Aktif</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <%= f.radio_button :is_active, false %>
              <span class="text-sm">Nonaktif</span>
            </label>
          </div>
        </div>
      </div>
    </div>

    <!-- Form Fields -->
    <div class="lg:col-span-8">
      <div class="bg-white rounded-2xl p-8 shadow-sm border border-admin-outline-variant/20 space-y-6">
        <div class="space-y-2">
          <%= f.label :name, "Nama Layanan / Desain", class: "text-sm font-bold text-admin-text" %>
          <%= f.text_field :name, placeholder: "Contoh: Rose Quartz Minimalist Art", class: "w-full bg-admin-surface-container-low border-0 rounded-xl px-5 py-4 focus:ring-2 focus:ring-admin-primary" %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <%= f.label :service_category_id, "Kategori", class: "text-sm font-bold text-admin-text" %>
            <%= f.collection_select :service_category_id, @categories, :id, :name, { prompt: "Pilih Kategori" }, { class: "w-full bg-admin-surface-container-low border-0 rounded-xl px-5 py-4 focus:ring-2 focus:ring-admin-primary" } %>
          </div>

          <div class="space-y-2">
            <%= f.label :price, "Harga (IDR)", class: "text-sm font-bold text-admin-text" %>
            <%= f.number_field :price, placeholder: "150000", class: "w-full bg-admin-surface-container-low border-0 rounded-xl px-5 py-4 focus:ring-2 focus:ring-admin-primary" %>
          </div>
        </div>

        <div class="space-y-2">
          <%= f.label :description, "Deskripsi Layanan", class: "text-sm font-bold text-admin-text" %>
          <%= f.text_area :description, rows: 5, placeholder: "Tuliskan detail desain, waktu pengerjaan, dan bahan yang digunakan...", class: "w-full bg-admin-surface-container-low border-0 rounded-xl px-5 py-4 focus:ring-2 focus:ring-admin-primary resize-none" %>
        </div>

        <div class="space-y-2">
          <%= f.label :duration_minutes, "Estimasi Waktu (menit)", class: "text-sm font-bold text-admin-text" %>
          <%= f.number_field :duration_minutes, placeholder: "60", class: "w-full bg-admin-surface-container-low border-0 rounded-xl px-5 py-4 focus:ring-2 focus:ring-admin-primary" %>
        </div>
      </div>

      <div class="flex justify-end gap-4 mt-6">
        <%= link_to "Batal", admin_services_path, class: "px-8 py-4 rounded-xl border border-admin-primary text-admin-primary font-bold hover:bg-admin-primary-fixed/20 transition-all" %>
        <%= f.submit "Simpan Katalog", class: "px-10 py-4 rounded-xl bg-admin-primary text-white font-bold hover:opacity-90 transition-all cursor-pointer" %>
      </div>
    </div>
  </div>
<% end %>