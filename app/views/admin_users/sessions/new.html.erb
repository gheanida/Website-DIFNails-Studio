<div class="w-full max-w-md px-6">
  <div class="glass-effect p-12 rounded-[2rem] shadow-2xl flex flex-col items-center">
    <div class="mb-12 text-center">
      <h1 class="font-['Bodoni_Moda'] text-4xl text-admin-primary tracking-tighter mb-2">DIFNails</h1>
      <p class="font-['Plus_Jakarta_Sans'] text-xs text-admin-text-muted uppercase tracking-[0.2em]">Management Portal</p>
    </div>

    <% if flash[:alert] %>
      <div class="w-full mb-6 p-3 text-xs rounded bg-red-50 border border-red-200 text-red-700">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "w-full space-y-10" }) do |f| %>
      <div class="space-y-8">
        <div class="flex flex-col gap-2 relative">
          <%= f.label :email, "Email Address", class: "font-['Plus_Jakarta_Sans'] text-sm text-admin-text-muted opacity-70" %>
          <%= f.email_field :email, autofocus: true, placeholder: "name@difnails.com", required: true, class: "boutique-input w-full py-2 font-['Plus_Jakarta_Sans'] text-admin-text bg-transparent border-0 border-b border-admin-outline-variant focus:outline-none focus:border-admin-primary transition-colors" %>
        </div>

        <div class="flex flex-col gap-2 relative">
          <%= f.label :password, class: "font-['Plus_Jakarta_Sans'] text-sm text-admin-text-muted opacity-70" %>
          <%= f.password_field :password, placeholder: "••••••••", required: true, class: "boutique-input w-full py-2 font-['Plus_Jakarta_Sans'] text-admin-text bg-transparent border-0 border-b border-admin-outline-variant focus:outline-none focus:border-admin-primary transition-colors" %>
        </div>
      </div>

      <%= f.submit "Sign In", class: "w-full bg-admin-primary text-white py-4 rounded-xl font-['Plus_Jakarta_Sans'] text-sm uppercase tracking-widest shadow-lg hover:shadow-xl hover:opacity-90 transform active:scale-[0.98] transition-all duration-300 cursor-pointer" %>
    <% end %>

  </div>
</div>

<style>
  .glass-effect {
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(212, 163, 115, 0.3);
  }
  .boutique-input:focus { box-shadow: none; }
  .fade-in { animation: fadeIn 0.8s ease-out forwards; }
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>