<div class="px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto mb-8">
  <%= link_to "&larr; Kembali ke Katalog".html_safe, services_path, class: "text-sm text-customer-primary hover:text-customer-tertiary mb-6 inline-block" %>

  <div class="bg-white/60 border border-customer-outline-variant/20 rounded-2xl overflow-hidden shadow-sm">
    <div class="h-64 sm:h-80 bg-customer-surface-container">
      <% if @service.photo.attached? %>
        <%= image_tag @service.photo, class: "w-full h-full object-cover" %>
      <% elsif @service.image_url.present? %>
        <%= image_tag @service.image_url, class: "w-full h-full object-cover" %>
      <% end %>
    </div>
    <div class="p-8">
      <% if @service.service_category %>
        <span class="text-xs uppercase tracking-widest text-customer-primary"><%= @service.service_category.name %></span>
      <% end %>
      <h1 class="font-['Bodoni_Moda'] text-3xl text-customer-text mt-2 mb-4"><%= @service.name %></h1>
      <p class="text-customer-text-muted mb-6"><%= @service.description %></p>
      <div class="flex items-center justify-between border-t border-customer-outline-variant/20 pt-6">
        <span class="text-2xl font-semibold text-customer-primary"><%= number_to_currency(@service.price, unit: "Rp ", precision: 0, delimiter: ".") %></span>
        <%= link_to "Book Sekarang", new_time_bookings_path(service_id: @service.id), class: "bg-customer-primary text-white px-8 py-3 rounded-full font-medium hover:opacity-90 transition-all" %>
      </div>
    </div>
  </div>
</div>