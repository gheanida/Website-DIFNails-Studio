<!DOCTYPE html>
<html>
<head>
<title><%= content_for(:title) || "DIFNails Admin Portal" %></title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<%= csrf_meta_tags %>
    <%= csp_meta_tag %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Text:wght@400;700&family=Hanken+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

<script>
  window.onUsersnapLoad = function(api) {
    api.init();
  };
  var script = document.createElement('script');
  script.defer = 1;
  script.src = 'https://widget.usersnap.com/global/load/5b1c698c-906b-4bc6-a0c0-31289207e68e?onload=onUsersnapLoad';
  document.getElementsByTagName('head')[0].appendChild(script);
</script>
</head>
<body class="bg-admin-bg text-admin-text font-['Hanken_Grotesk'] overflow-x-hidden">
<!-- Sidebar -->
<aside class="fixed left-0 top-0 h-full w-[280px] flex flex-col py-8 px-4 bg-admin-surface-container-low shadow-sm z-50">
<div class="px-4 mb-10">
<h1 class="text-xl font-['Libre_Caslon_Text'] font-bold text-admin-primary">DIFNails Admin</h1>
<p class="text-xs text-admin-outline uppercase tracking-widest mt-1 opacity-70">Management Portal</p>
</div>

<nav class="flex-1 space-y-1">
<%= link_to admin_dashboard_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg transition-colors #{current_page?(admin_dashboard_path) || current_page?(admin_root_path) ? 'bg-admin-secondary-container text-admin-primary border-l-4 border-admin-primary font-bold' : 'text-admin-text-muted hover:text-admin-primary hover:bg-admin-primary-fixed/20'}" do %>
          Dashboard
        <% end %>
<%= link_to admin_services_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg transition-colors #{current_page?(admin_services_path) ? 'bg-admin-secondary-container text-admin-primary border-l-4 border-admin-primary font-bold' : 'text-admin-text-muted hover:text-admin-primary hover:bg-admin-primary-fixed/20'}" do %>
          Katalog
        <% end %>
<%= link_to admin_bookings_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg transition-colors #{current_page?(admin_bookings_path) ? 'bg-admin-secondary-container text-admin-primary border-l-4 border-admin-primary font-bold' : 'text-admin-text-muted hover:text-admin-primary hover:bg-admin-primary-fixed/20'}" do %>
          Reservasi
        <% end %>
<%= link_to admin_queue_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg transition-colors #{current_page?(admin_queue_path) ? 'bg-admin-secondary-container text-admin-primary border-l-4 border-admin-primary font-bold' : 'text-admin-text-muted hover:text-admin-primary hover:bg-admin-primary-fixed/20'}" do %>
          Antrian
        <% end %>
<%= link_to admin_transactions_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg transition-colors #{current_page?(admin_transactions_path) ? 'bg-admin-secondary-container text-admin-primary border-l-4 border-admin-primary font-bold' : 'text-admin-text-muted hover:text-admin-primary hover:bg-admin-primary-fixed/20'}" do %>
          Keuangan
        <% end %>
<%= link_to admin_customers_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg transition-colors #{current_page?(admin_customers_path) ? 'bg-admin-secondary-container text-admin-primary border-l-4 border-admin-primary font-bold' : 'text-admin-text-muted hover:text-admin-primary hover:bg-admin-primary-fixed/20'}" do %>
          Customers
        <% end %>
<%= link_to admin_settings_path, class: "flex items-center gap-3 px-4 py-3 rounded-lg transition-colors #{current_page?(admin_settings_path) ? 'bg-admin-secondary-container text-admin-primary border-l-4 border-admin-primary font-bold' : 'text-admin-text-muted hover:text-admin-primary hover:bg-admin-primary-fixed/20'}" do %>
          Settings
        <% end %>
</nav>

<div class="mt-auto border-t border-admin-outline-variant pt-4 px-2">
<%= button_to destroy_admin_user_session_path, method: :delete, class: "w-full flex items-center gap-3 text-admin-text-muted hover:text-admin-error px-4 py-3 transition-colors rounded-lg text-left" do %>
          Logout
        <% end %>
</div>
</aside>

<!-- Top Bar -->
<header class="flex justify-between items-center h-20 px-8 ml-[280px] w-[calc(100%-280px)] bg-admin-bg sticky top-0 z-40 border-b border-admin-outline-variant/30">
<div class="flex items-center gap-4 bg-admin-surface-container-low px-4 py-2 rounded-full w-96">
<span class="text-admin-outline">🔍</span>
<span class="text-sm text-admin-outline/70">Cari antrian atau pelanggan...</span>
</div>
<div class="flex items-center gap-3">
<div class="w-10 h-10 rounded-full bg-admin-primary-fixed flex items-center justify-center text-admin-primary font-bold">
<%= current_admin_user.email.first.upcase %>
        </div>
<div>
<p class="text-sm font-bold text-admin-text">Admin</p>
<p class="text-[10px] text-admin-outline uppercase tracking-tighter">Super Admin</p>
</div>
</div>
</header>

<!-- Main Content -->
<main class="ml-[280px] p-8 min-h-screen max-w-[calc(100%-280px)] overflow-x-hidden">
<% if notice %>
        <div class="mb-6 p-4 rounded-lg bg-admin-primary-fixed text-admin-primary text-sm"><%= notice %></div>
<% end %>
      <% if alert %>
<div class="mb-6 p-4 rounded-lg bg-red-100 text-red-700 text-sm"><%= alert %></div>
<% end %>
      <%= yield %>
</main>
</body>
</html>