<!DOCTYPE html>
<html lang="id">
  <head>
    <title><%= content_for(:title) || "DIFNails | Luxury Nail Art Salon" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-customer-bg text-customer-text font-['Plus_Jakarta_Sans']">

    <nav class="fixed top-0 w-full z-50 bg-customer-surface/80 backdrop-blur-md shadow-sm border-b border-customer-outline/30">
      <div class="flex justify-between items-center h-20 px-8 max-w-[1440px] mx-auto">
        <%= link_to "DIFNails", root_path, class: "text-2xl font-['Bodoni_Moda'] text-customer-primary tracking-tight" %>
        <div class="hidden md:flex items-center gap-8">
          <%= link_to "Beranda", root_path, class: "#{current_page?(root_path) ? 'text-customer-primary border-b-2 border-customer-primary pb-1' : 'text-customer-text-muted hover:text-customer-primary'} transition-colors text-sm font-medium" %>
          <%= link_to "Katalog", services_path, class: "#{current_page?(services_path) ? 'text-customer-primary border-b-2 border-customer-primary pb-1' : 'text-customer-text-muted hover:text-customer-primary'} transition-colors text-sm font-medium" %>
          <%= link_to "Jadwal Antrian", bookings_path, class: "text-customer-text-muted hover:text-customer-primary transition-colors text-sm font-medium" %>
        </div>
        <%= link_to "Book Now", new_booking_path, class: "bg-customer-primary text-white px-6 py-2.5 rounded-full text-sm font-medium hover:opacity-90 active:scale-95 transition-all" %>
      </div>
    </nav>

    <main class="pt-24 sm:pt-28 pb-20">
      <%= yield %>
    </main>

    <footer class="w-full bg-customer-surface-container-highest border-t border-customer-outline/20 py-16">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-12 px-8 max-w-[1440px] mx-auto">
        <div class="space-y-4">
          <div class="text-xl font-['Bodoni_Moda'] text-customer-primary">DIFNails</div>
          <p class="text-sm text-customer-text-muted">The destination for premium nail artistry and luxury spa treatments.</p>
        </div>
        <div class="space-y-4">
          <h4 class="font-semibold text-customer-text">Explore</h4>
          <ul class="space-y-2 text-sm">
            <li><%= link_to "Beranda", root_path, class: "text-customer-text-muted hover:text-customer-primary" %></li>
            <li><%= link_to "Katalog", services_path, class: "text-customer-text-muted hover:text-customer-primary" %></li>
            <li><%= link_to "Jadwal Antrian", bookings_path, class: "text-customer-text-muted hover:text-customer-primary" %></li>
          </ul>
        </div>
        <div class="space-y-4">
          <h4 class="font-semibold text-customer-text">Connect</h4>
          <p class="text-xs text-customer-text-muted">© 2026 DIFNails Premium Salon. All rights reserved.</p>
        </div>
      </div>
    </footer>
  </body>
</html>