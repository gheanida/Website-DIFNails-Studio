<div class="space-y-8 max-w-xl mx-auto">
  <!-- Header -->
  <div>
    <%= link_to "&larr; Back to My Appointments".html_safe, customer_bookings_path, class: "text-sm text-customer-primary hover:text-customer-tertiary transition-colors" %>
    <h1 class="font-serif text-3xl font-bold text-customer-primary mt-4">Book an Appointment</h1>
    <p class="text-sm text-customer-text-muted mt-1">Reserve your spot at DIFNails. Select your service, date, and preferred time below.</p>
  </div>

  <!-- Form Card -->
  <%= form_with(model: [:customer, @booking], local: true, class: "bg-customer-lowest border border-customer-outline-variant/30 rounded-[24px] p-8 space-y-6 shadow-sm") do |f| %>
    <% if @booking.errors.any? %>
      <div class="p-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">
        <h2 class="font-semibold mb-2"><%= pluralize(@booking.errors.count, "error") %> prohibited this booking from being saved:</h2>
        <ul class="list-disc pl-5 space-y-1">
          <% @booking.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Select Service -->
    <div class="space-y-2">
      <%= f.label :service_id, "Select Treatment", class: "block text-xs font-semibold uppercase tracking-wider text-customer-primary" %>
      <%= f.collection_select :service_id, @services, :id, ->(s) { "#{s.name} - #{number_to_currency(s.price, unit: 'Rp ', precision: 0, delimiter: '.')}" }, { selected: params[:service_id] }, class: "w-full bg-customer-bg text-customer-text border-b-2 border-t-0 border-x-0 border-customer-tertiary px-3 py-2.5 text-sm focus:ring-0 focus:border-customer-primary transition-colors cursor-pointer" %>
    </div>

    <!-- Date Selection -->
    <div class="space-y-2">
      <%= f.label :booking_date, "Appointment Date", class: "block text-xs font-semibold uppercase tracking-wider text-customer-primary" %>
      <%= f.date_field :booking_date, required: true, min: Date.today.to_s, class: "w-full bg-customer-bg text-customer-text border-b-2 border-t-0 border-x-0 border-customer-tertiary px-3 py-2.5 text-sm focus:ring-0 focus:border-customer-primary transition-colors" %>
    </div>

    <!-- Time Selection -->
    <div class="space-y-2">
      <%= f.label :booking_time, "Preferred Time", class: "block text-xs font-semibold uppercase tracking-wider text-customer-primary" %>
      <%= f.time_field :booking_time, required: true, class: "w-full bg-customer-bg text-customer-text border-b-2 border-t-0 border-x-0 border-customer-tertiary px-3 py-2.5 text-sm focus:ring-0 focus:border-customer-primary transition-colors" %>
    </div>

    <!-- Notes -->
    <div class="space-y-2">
      <%= f.label :notes, "Special Notes / Custom Requests", class: "block text-xs font-semibold uppercase tracking-wider text-customer-primary" %>
      <%= f.text_area :notes, placeholder: "Wants chrome powder, specific nail shapes, silent appointment, etc.", rows: 3, class: "w-full bg-customer-bg text-customer-text border-b-2 border-t-0 border-x-0 border-customer-tertiary px-3 py-2.5 text-sm focus:ring-0 focus:border-customer-primary transition-colors" %>
    </div>

    <!-- Submit Buttons -->
    <div class="flex flex-col gap-3 pt-4 border-t border-customer-outline-variant/20">
      <%= f.submit "Confirm Reservation", class: "w-full text-center px-6 py-3.5 rounded-full bg-customer-tertiary text-white text-xs font-semibold uppercase tracking-wider hover:opacity-90 transition-all cursor-pointer shadow-sm" %>
      <%= link_to "Cancel", customer_bookings_path, class: "w-full text-center px-6 py-3.5 rounded-full border border-customer-primary text-customer-primary text-xs font-semibold uppercase tracking-wider hover:bg-customer-primary-container/30 transition-all" %>
    </div>
  <% end %>
</div>
