<div class="max-w-4xl mx-auto">
  <%= render "stepper", current_step: 1 %>

  <h1 class="font-['Bodoni_Moda'] text-3xl text-customer-primary text-center mb-8">Pilih Layanan Kami</h1>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <% @services.each do |service| %>
      <%= link_to new_time_bookings_path(service_id: service.id),
          class: "block p-6 rounded-xl border border-customer-outline-variant/30 hover:border-customer-primary/50 transition-all group bg-customer-lowest" do %>
        <div class="w-full h-40 rounded-lg mb-4 overflow-hidden bg-customer-surface-container">
          <% if service.image_url.present? %>
            <%= image_tag service.image_url, class: "w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" %>
          <% end %>
        </div>
        <div class="flex justify-between items-start mb-2">
          <h3 class="font-semibold text-customer-text"><%= service.name %></h3>
          <span class="text-sm text-customer-primary font-medium"><%= number_to_currency(service.price, unit: "Rp ", precision: 0, delimiter: ".") %></span>
        </div>
        <p class="text-customer-text-muted text-sm"><%= service.description %></p>
      <% end %>
    <% end %>
  </div>
</div>