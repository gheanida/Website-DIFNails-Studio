<!DOCTYPE html>
<html>
  <head>
    <title>Sign In - DIFNails</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..700;1,6..96,400..700&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <style>
      body {
        font-family: var(--font-dm), 'DM Sans', sans-serif;
        background-color: var(--color-customer-bg, #fff8f7);
        color: var(--color-customer-text, #221919);
      }
      h1, h2, h3, .font-serif {
        font-family: var(--font-bodoni), 'Bodoni Moda', serif;
      }
    </style>
  </head>

  <body class="min-h-screen flex items-center justify-center bg-customer-bg text-customer-text px-6 py-12">
    <div class="w-full max-w-md bg-customer-lowest border border-customer-outline-variant/30 rounded-[24px] p-8 space-y-6 shadow-md">
      <!-- Title -->
      <div class="text-center space-y-2">
        <span class="text-xs font-semibold tracking-wider text-customer-primary uppercase">Welcome Back</span>
        <h1 class="font-serif text-3xl font-bold text-customer-primary">Client Login</h1>
        <p class="text-xs text-customer-text-muted">Enter email and password to access your booking dashboard.</p>
      </div>

      <!-- Devise Form -->
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>
        <!-- Alert / Notice Messages -->
        <% if flash[:alert] %>
          <div class="p-3 text-xs rounded bg-red-50 border border-red-200 text-red-700">
            <%= flash[:alert] %>
          </div>
        <% end %>
        <% if flash[:notice] %>
          <div class="p-3 text-xs rounded bg-customer-primary-container text-customer-primary border border-customer-outline-variant">
            <%= flash[:notice] %>
          </div>
        <% end %>

        <!-- Email Field (stationery style bottom-border) -->
        <div class="space-y-1.5">
          <%= f.label :email, class: "block text-[10px] font-semibold uppercase tracking-wider text-customer-primary" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "w-full bg-customer-bg text-customer-text border-b-2 border-t-0 border-x-0 border-customer-tertiary px-3 py-2 text-sm focus:ring-0 focus:border-customer-primary transition-colors" %>
        </div>

        <!-- Password Field -->
        <div class="space-y-1.5">
          <%= f.label :password, class: "block text-[10px] font-semibold uppercase tracking-wider text-customer-primary" %>
          <%= f.password_field :password, autocomplete: "current-password", required: true, class: "w-full bg-customer-bg text-customer-text border-b-2 border-t-0 border-x-0 border-customer-tertiary px-3 py-2 text-sm focus:ring-0 focus:border-customer-primary transition-colors" %>
        </div>

        <!-- Remember Me Checkbox -->
        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "w-4 h-4 rounded bg-customer-bg text-customer-primary border-customer-outline cursor-pointer focus:ring-0 focus:ring-offset-0" %>
            <%= f.label :remember_me, "Remember my details", class: "text-xs text-customer-text-muted cursor-pointer select-none font-medium" %>
          </div>
        <% end %>

        <!-- Submit Button -->
        <div class="pt-2">
          <%= f.submit "Log In", class: "w-full py-3 rounded-full bg-customer-tertiary text-white text-xs font-semibold uppercase tracking-wider hover:opacity-90 transition-all cursor-pointer shadow-sm" %>
        </div>
      <% end %>

      <!-- Links (Registration, Forgot password, etc) -->
      <div class="flex flex-col items-center gap-2 pt-2 text-xs text-customer-text-muted">
        <p>Don't have an account? <%= link_to "Register Here", new_registration_path(resource_name), class: "font-semibold text-customer-primary hover:text-customer-tertiary hover:underline" %></p>
        <p><%= link_to "&larr; Back to Home Page".html_safe, root_path, class: "font-semibold text-customer-primary hover:text-customer-tertiary transition-colors" %></p>
      </div>
    </div>
  </body>
</html>
