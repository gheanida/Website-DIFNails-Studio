<div class="space-y-8 max-w-xl mx-auto">
  <!-- Header -->
  <div>
    <%= link_to "&larr; Back to Profile".html_safe, customer_profile_path, class: "text-sm text-customer-primary hover:text-customer-tertiary transition-colors" %>
    <h1 class="font-serif text-3xl font-bold text-customer-primary mt-4">Edit Profile</h1>
    <p class="text-sm text-customer-text-muted mt-1">Modify your contact details or change your password below.</p>
  </div>

  <!-- Form Card -->
  <%= form_with(model: @customer, url: customer_profile_path, method: :patch, local: true, class: "bg-customer-lowest border border-customer-outline-variant/30 rounded-[24px] p-8 space-y-6 shadow-sm") do |f| %>
    <% if @customer.errors.any? %>
      <div class="p-4 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">
        <h2 class="font-semibold mb-2"><%= pluralize(@customer.errors.count, "error") %> prohibited your profile from being saved:</h2>
        <ul class="list-disc pl-5 space-y-1">
          <% @customer.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <!-- Full Name -->
    <div class="space-y-2">
      <%= f.label :name, "Full Name", class: "block text-xs font-semibold uppercase tracking-wider text-customer-primary" %>
      <%= f.text_field :name, class: "w-full bg-customer-bg text-customer-text border-b-2 border-t-0 border-x-0 border-customer-tertiary px-3 py-2.5 text-sm focus:ring-0 focus:border-customer-primary transition-colors" %>
    </div>

    <!-- Phone Number -->
    <div class="space-y-2">
      <%= f.label :phone, "Phone Number", class: "block text-xs font-semibold uppercase tracking-wider text-customer-primary" %>
      <%= f.telephone_field :phone, class: "w-full bg-customer-bg text-customer-text border-b-2 border-t-0 border-x-0 border-customer-tertiary px-3 py-2.5 text-sm focus:ring-0 focus:border-customer-primary transition-colors" %>
    </div>

    <!-- Email Address -->
    <div class="space-y-2">
      <%= f.label :email, "Email Address", class: "block text-xs font-semibold uppercase tracking-wider text-customer-primary" %>
      <%= f.email_field :email, class: "w-full bg-customer-bg text-customer-text border-b-2 border-t-0 border-x-0 border-customer-tertiary px-3 py-2.5 text-sm focus:ring-0 focus:border-customer-primary transition-colors" %>
    </div>

    <div class="pt-4 border-t border-customer-outline-variant/20">
      <p class="text-xs text-customer-text-muted mb-4">Leave password fields blank if you do not wish to change your password.</p>
      
      <!-- Password -->
      <div class="space-y-2 mb-4">
        <%= f.label :password, "New Password", class: "block text-xs font-semibold uppercase tracking-wider text-customer-primary" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "w-full bg-customer-bg text-customer-text border-b-2 border-t-0 border-x-0 border-customer-tertiary px-3 py-2.5 text-sm focus:ring-0 focus:border-customer-primary transition-colors" %>
      </div>

      <!-- Password Confirmation -->
      <div class="space-y-2">
        <%= f.label :password_confirmation, "Confirm New Password", class: "block text-xs font-semibold uppercase tracking-wider text-customer-primary" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full bg-customer-bg text-customer-text border-b-2 border-t-0 border-x-0 border-customer-tertiary px-3 py-2.5 text-sm focus:ring-0 focus:border-customer-primary transition-colors" %>
      </div>
    </div>

    <!-- Submit Buttons -->
    <div class="flex flex-col gap-3 pt-4 border-t border-customer-outline-variant/20">
      <%= f.submit "Save Profile Details", class: "w-full text-center px-6 py-3.5 rounded-full bg-customer-tertiary text-white text-xs font-semibold uppercase tracking-wider hover:opacity-90 transition-all cursor-pointer shadow-sm" %>
      <%= link_to "Cancel", customer_profile_path, class: "w-full text-center px-6 py-3.5 rounded-full border border-customer-primary text-customer-primary text-xs font-semibold uppercase tracking-wider hover:bg-customer-primary-container/30 transition-all" %>
    </div>
  <% end %>
</div>
